{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "public/r/**"]
    },
    "registry:build": {
      "dependsOn": ["^build"],
      "outputs": ["public/r/**", "registry/__index__.tsx", "registry/__sources__.ts"]
    },
    "typecheck": {
      // The registry index and sources are generated and gitignored, so on a
      // fresh checkout they do not exist yet and the docs site fails to compile.
      // Declaring the dependency here rather than adding a step to the workflow
      // keeps every entry point correct — CI, a local run, any task order.
      "dependsOn": ["^build", "registry:build"]
    },
    "dev": {
      // Both apps consume the kernel's generated `dist/tokens.css`, so on a
      // fresh checkout `dev` has nothing to import until the package has been
      // built once. Declared here rather than in each app's script so every
      // entry point gets it.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
